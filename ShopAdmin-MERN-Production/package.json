{
  "name": "shopadmin-mern",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,green \"npm --prefix backend run dev\" \"npm --prefix ../admin-dashboard run dev -- --host 0.0.0.0\"",
    "start": "npm --prefix backend start",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix ../admin-dashboard run dev -- --host 0.0.0.0",
    "seed": "npm --prefix backend run seed",
    "build": "npm --prefix ../admin-dashboard run build",
    "test": "npm --prefix backend test",
    "coverage": "npm --prefix backend run test:coverage",
    "lint": "npm --prefix backend run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "mongoose": "^9.11.2"
  }
}
